<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Sideload only: Play restricts this one. Keeps the listener alive through Doze. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Personal sideloaded build: never backed up to Google, the queue holds message text. -->
    <application
        android:allowBackup="false"
        android:label="soloyolo listener"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ListenerService"
            android:exported="true"
            android:label="soloyolo listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <!-- Android 12+: skip ongoing notifications ("Checking for new messages", calls, media).
                 Silent ones stay: a muted chat that still posts quietly is still a chat. -->
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="ongoing" />
        </service>
    </application>
</manifest>
