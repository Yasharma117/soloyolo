<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except a Mac on your tailnet: that traffic is already inside WireGuard,
     so tailscale serve over plain HTTP without a certificate is allowed for *.ts.net names. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
