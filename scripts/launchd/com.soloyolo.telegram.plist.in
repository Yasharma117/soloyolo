<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-mac.sh fills in the placeholders and writes it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
	<key>Label</key><string>com.soloyolo.telegram</string>
	<!-- Applies your taps on the morning message as they come (long polling, outbound only).
	     Not paired yet: it exits cleanly and stays stopped until the next login or install. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>@JOB@</string>
		<string>telegram</string>
	</array>
	<key>RunAtLoad</key><true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key><false/>
	</dict>
	<key>ThrottleInterval</key><integer>60</integer>
	<key>StandardOutPath</key><string>@DATA@/logs/telegram.log</string>
	<key>StandardErrorPath</key><string>@DATA@/logs/telegram.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key><string>@PATH@</string>
		<key>LANG</key><string>en_US.UTF-8</string>
		<key>PYTHONUNBUFFERED</key><string>1</string>
		<key>SOLOYOLO_REPO</key><string>@REPO@</string>
		<key>SOLOYOLO_DATA</key><string>@DATA@</string>
		<key>SOLOYOLO_PYTHON</key><string>@PYTHON@</string>
	</dict>
	<key>WorkingDirectory</key><string>@REPO@</string>
	<key>Umask</key><integer>63</integer>
</dict>
</plist>
